    {
      "type": "timeseries",
      "title": "Responses by status class",
      "description": "",
      "id": 11,
      "datasource": {
        "type": "prometheus",
        "uid": "finpilot-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
