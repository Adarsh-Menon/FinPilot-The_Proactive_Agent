      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "finpilot-prometheus"
          },
          "expr": "sum by (class) (label_replace(rate(finpilot_http_requests_total[$__rate_interval]), \"class\", \"${1}xx\", \"status\", \"(.).*\"))",
          "legendFormat": "{{class}}"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
