# Local development only. Synthetic data recommended until production gates pass.
ENVIRONMENT=local
DATABASE_URL=sqlite:///./runtime/finpilot.db
COOKIE_SECURE=false
# Master key that encrypts customer data; keep it outside the project and synced folders.
# MASTER_KEY_FILE=~/.finpilot/master.key
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8010,http://127.0.0.1:8010
INFERENCE_PROVIDER=mesh
MESH_API_KEY=
# Shared model for all roles except risk; confirm exact IDs via GET https://api.meshapi.ai/v1/models.
MESH_MODEL=deepseek/deepseek-v4-flash
# Risk never silently falls back to the shared model.
MESH_RISK_MODEL=qwen/qwen3.5-122b-a10b
# Speech to text for voice input (audio in, text out). Empty keeps voice in the browser.
MESH_SPEECH_MODEL=
# USD per million tokens [input, output], used for the admin cost column. Update when prices change.
MODEL_PRICES={"deepseek/deepseek-v4-flash": [0.05, 0.45], "qwen/qwen3.5-122b-a10b": [0.26, 2.08]}
# Optional sanitized LangSmith tracing of agent nodes and Mesh calls. Inputs/outputs are
# reduced to an allowlist (agent, model, prompt version, counts, token usage) before export.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=finpilot-local
# LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com
# Optional Prometheus/Grafana stack (compose.observability.yaml). Set a unique local password.
GRAFANA_ADMIN_PASSWORD=
# Optional PostgreSQL/Redis development services. Set unique local secrets before compose up.
POSTGRES_PASSWORD=
APP_DB_PASSWORD=
OPS_DB_PASSWORD=
# DATABASE_URL=postgresql+psycopg://finpilot_app:<url-encoded-password>@localhost:5432/finpilot
# OPS_DATABASE_URL=postgresql+psycopg://finpilot_ops:<url-encoded-password>@localhost:5432/finpilot
# Phone alerts (Telegram). Create a bot with @BotFather, send it /start from your phone, then read your
# chat id from https://api.telegram.org/bot<TOKEN>/getUpdates. Empty keeps alerts in the admin portal only.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Hybrid forecaster: frozen time-series foundation model for everyday spending (needs requirements-forecast.txt).
# Empty uses the trailing-mean baseline.
FORECAST_MODEL=amazon/chronos-bolt-small
